@page "/View"
@layout ViewLayout

<HeadContent>
    <link href="css/view.css" rel="stylesheet" />
    <script src="js/jquery-3.6.0/jquery-3.6.0.min.js"></script>
    <script src="js/jquery.nicescroll-3.6.8/jquery.nicescroll.min.js"></script>
    <script src="js/view.js"></script>
</HeadContent>

<div id="root" class="row p-1 bg-dark m-0 w-100 h-100 ViewRoot">
    <div class="col-lg-3 col-md-4 col-sm-6 h-100" style="padding: 1px;@(showLeftPanel?"":"display: none;")">
        <div class="border_corner border_corner_left_top"></div>
        <div class="border_corner border_corner_right_top"></div>
        <div class="border_corner border_corner_left_bottom"></div>
        <div class="border_corner border_corner_right_bottom"></div>
        <div class="h-100 ViewBorder" style="display:flex;flex-direction:column;">
            <div class="card bg-dark ViewCard" style="height: 50%;background-color: transparent!important;">
                <div class="card-header p-0">
                    <div class="form">
                        <div class="input-group">
                            <div class="input-group-prepend">
                            </div>
                            <select id="viewGridSelect" class="form-control form-control-sm TransparentBgButton pl-1" style="padding-left: 13px!important; margin-right: 10px;" @onchange="SelectedViewGridChanged">
                                @foreach (var viewGrid in Controls.ViewGrids.ViewGridManager.Instance.GetViewGrids())
                                {
                                    @if (viewGrid.Id == selectedViewGrid)
                                    {
                                        <option value="@viewGrid.Id" selected>@viewGrid.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@viewGrid.Id">@viewGrid.Name</option>
                                    }
                                }
                            </select>
                            <div class="input-group-append">
                                <button type="button" class="btn btn-sm btn-secondary TransparentBgButton" style="padding-right: 12px;" @onclick="setting">
                                    <i class="fa fa-cog"></i>
                                </button>
                            </div>
                        </div>
                        <div class="input-group">
                            <input type="text" class="form-control form-control-sm pl-3" placeholder="搜索" @bind-value="searchKeywords">
                            <div class="input-group-append">
                                <button type="button" class="btn btn-sm btn-secondary TransparentBgButton" style="padding-right: 12px;" @onclick="refresh">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="tree" class="card-body p-0" style="overflow: auto;">
                    <Tree @ref="tree" DataSource="_datas" SelectedNodeChanged="onSelectedNodeChanged" ShowIcon
                          TitleExpression="x=>((Data)x.DataItem).Title"
                          ChildrenExpression="x=>((Data)x.DataItem).Childs"
                          IconExpression="@(x=>((Data)x.DataItem).IsLeaf?"fa fa-camera": "fa fa-map-marker")"
                          IsLeafExpression="x=>((Data)x.DataItem).IsLeaf"
                          TreeClass="treeview ChannelTree"
                          TreeNodeDblClicked="onTreeNodeDblClicked"></Tree>
                </div>
            </div>
            <div class="card bg-dark ViewCard" style="height: 50%;">
                <div class="card-header pt-2 pb-2">
                    云台控制
                </div>
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col">
                            <table class="ptz-table">
                                <tbody>
                                    <tr>
                                        <td></td>
                                        <td style="width:40px;"></td>
                                        <td style="width:40px;"></td>
                                        <td style="width:40px;"></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style ="height:40px;"></td>
                                        <td></td>
                                        <td>
                                            @if (selectedChannel == null)
                                            {
                                                <button class="btn" disabled></button>
                                            }
                                            else
                                            {
                                                <button class="btn" @onmousedown="moveUp" @onmouseup="stopMove"></button>
                                            }
                                        </td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="height:40px;"></td>
                                        <td>
                                            @if (selectedChannel == null)
                                            {
                                                <button class="btn" disabled></button>
                                            }
                                            else
                                            {
                                                <button class="btn" @onmousedown="moveLeft" @onmouseup="stopMove"></button>
                                            }
                                        </td>
                                        <td>
                                            @if (selectedChannel == null)
                                            {
                                                <button class="btn" disabled></button>
                                            }
                                            else
                                            {
                                                <button class="btn" @onclick="autoPan"></button>
                                            }
                                        </td>
                                        <td>
                                            @if (selectedChannel == null)
                                            {
                                                <button class="btn" disabled></button>
                                            }
                                            else
                                            {
                                                <button class="btn" @onmousedown="moveRight" @onmouseup="stopMove"></button>
                                            }
                                        </td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="height:40px;"></td>
                                        <td></td>
                                        <td>
                                            @if (selectedChannel == null)
                                            {
                                                <button class="btn" disabled></button>
                                            }
                                            else
                                            {
                                                <button class="btn" @onmousedown="moveDown" @onmouseup="stopMove"></button>
                                            }
                                        </td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="input-group" style="border: 0 !important;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text pt-0 pb-0">减速</span>
                                </div>
                                <input type="range" min="0" max="1" step="0.1" class="form-control form-control-sm form-control-range" @bind-value="moveSpeed">
                                <div class="input-group-append">
                                    <span class="input-group-text pt-0 pb-0">加速</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="btn-toolbar mt-2 ml-4 mr-4 justify-content-between" role="toolbar">
                                <div class="btn-group btn-group-sm border rounded-pill" role="group">
                                    @if (selectedChannel == null)
                                    {
                                        <button type="button" class="btn TransparentBgButton" disabled>
                                            <img src="images/icon/zoom_in.png">
                                        </button>
                                        <button type="button" class="btn TransparentBgButton" disabled>
                                            <img src="images/icon/zoom_out.png">
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn TransparentBgButton" @onmousedown="zoomIn" @onmouseup="stopMove">
                                            <img src="images/icon/zoom_in.png">
                                        </button>
                                        <button type="button" class="btn TransparentBgButton" @onmousedown="zoomOut" @onmouseup="stopMove">
                                            <img src="images/icon/zoom_out.png">
                                        </button>
                                    }
                                </div>
                                <div class="btn-group btn-group-sm border rounded-pill" role="group">
                                    @if (selectedChannel == null)
                                    {
                                        <button type="button" class="btn TransparentBgButton" disabled>
                                            <img src="images/icon/focus_out.png">
                                        </button>
                                        <button type="button" class="btn TransparentBgButton" disabled>
                                            <img src="images/icon/focus_in.png">
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn TransparentBgButton" @onmousedown="focusNear" @onmouseup="stopMove">
                                            <img src="images/icon/focus_out.png">
                                        </button>
                                        <button type="button" class="btn TransparentBgButton" @onmousedown="focusFar" @onmouseup="stopMove">
                                            <img src="images/icon/focus_in.png">
                                        </button>
                                    }
                                </div>
                                <div class="btn-group btn-group-sm border rounded-pill" role="group">
                                    @if (selectedChannel == null)
                                    {
                                        <button type="button" class="btn TransparentBgButton" disabled>
                                            <img src="images/icon/iris_in.png">
                                        </button>
                                        <button type="button" class="btn TransparentBgButton" disabled>
                                            <img src="images/icon/iris_out.png">
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn TransparentBgButton" @onmousedown="irisOut" @onmouseup="stopMove">
                                            <img src="images/icon/iris_in.png">
                                        </button>
                                        <button type="button" class="btn TransparentBgButton" @onmousedown="irisIn" @onmouseup="stopMove">
                                            <img src="images/icon/iris_out.png">
                                        </button>
                                    }
                                </div>
                            </div>                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="h-100">
        <table class="h-100">
            <tr><td></td></tr>
            <tr>
                <td>
                    <button class="btn-splitter" @onclick="@(e=>showLeftPanel=!showLeftPanel)">
                        @if (showLeftPanel)
                        {
                            <i class="fa fa-caret-left"></i>
                        }
                        else
                        {
                            <i class="fa fa-caret-right"></i>
                        }
                    </button>
                </td>
            </tr>
            <tr><td></td></tr>
        </table>
    </div>
    <div id="viewPanel" class="col h-100" style="padding: 1px;">
        <div class="border_corner border_corner_left_top"></div>
        <div class="border_corner border_corner_right_top"></div>
        <div class="border_corner border_corner_left_bottom"></div>
        <div class="border_corner border_corner_right_bottom"></div>
        <div class="h-100 ViewBorder">
            @viewGridRenderFragment
        </div>        
    </div>
</div>

<ModalLoading @ref="modalLoading" />
<ModalAlert @ref="modalAlert" />
<ModalWindow @ref="modalWindow" DialogCentered />