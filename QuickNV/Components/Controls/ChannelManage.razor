<div class="row">
    <div class="col-12">
        <div class="btn-toolbar">
            <div class="btn-group mr-2 mb-1">
                <button type="button" class="btn btn-sm btn-secondary" @onclick="Create">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    添加
                </button>
                @if (driverContext != null && driverContext.DriverInfo.CanImportChannel)
                {
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="Import">
                        <i class="fa fa-reply" aria-hidden="true"></i>
                        导入
                    </button>
                }
            </div>
            <div class="input-group ml-1 mb-1">
                <div class="input-group-prepend">
                    <div class="input-group-text">关键字</div>
                </div>
                <input type="text" class="form-control" @bind-value="searchKeywords">
                <div class="input-group-append">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="search">
                        <i class="fa fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
@if (channels != null)
{
    <div class="row">
        @foreach (var t in channels.Skip(Offset).Take(PageSize))
        {
            <div class="col-xl-4 col-lg-6 col-sm-12 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa fa-video-camera" aria-hidden="true"></i>
                        <span>@t.Name</span>
                    </div>
                    <div class="card-body small p-2">
                        <p class="mb-0">
                            <span class="font-weight-bold">编号: </span>@t.Id
                        </p>
                        <p class="mb-0">
                            <span class="font-weight-bold">地点: </span>@t.AddressName
                        </p>
                    </div>
                    <div class="card-footer p-1">
                        <div class="btn-toolbar" role="toolbar">
                            <div class="btn-group mr-2">
                                <button type="button" title="编辑" class="btn btn-sm btn-secondary" @onclick="() => Edit(t)">
                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                </button>
                                <button type="button" title="删除" class="btn btn-sm btn-secondary" @onclick="() => Delete(t)">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="btn-group mr-2">
                                <button type="button" title="快照" class="btn btn-sm btn-secondary" @onclick="() => Snapshot(t)">
                                    <i class="fa fa-camera" aria-hidden="true"></i>
                                </button>
                                <button type="button" title="直播" class="btn btn-sm btn-secondary" @onclick="() => Live(t)">
                                    <i class="fa fa-play" aria-hidden="true"></i>
                                </button>
                                <button type="button" title="回放" class="btn btn-sm btn-secondary" @onclick="() => Playback(t)">
                                    <i class="fa fa-file-video-o" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="btn-group mr-2">
                                <button type="button" title="日志" class="btn btn-sm btn-secondary"
                                    @onclick="() => DisplayLogs(t)">
                                    <i class="fa fa-file" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="row mt-2">
        <div class="col-12">
            <Pagination @bind-PageSize="PageSize" @bind-Offset="Offset" RecordCount="@channels.Length" />
        </div>
    </div>
}

<ModalWindow @ref="modalWindow" DialogSizeExtraLarge="true" DialogCentered="false" />
<ModalLoading @ref="modalLoading" />
<ModalAlert @ref="modalAlert" />
<ToastStack @ref="toastStack" />