<div class="row">
    <div class="col-12">
        <div class="btn-toolbar">
            <div class="btn-group mr-2 mb-1">
                <button type="button" class="btn btn-sm btn-secondary" @onclick="Create">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    添加
                </button>
            </div>
            <div class="input-group ml-1 mb-1">
                <div class="input-group-prepend">
                    <div class="input-group-text">驱动</div>
                </div>
                <div class="input-group-append">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="Import">
                        <i class="fa fa-reply" aria-hidden="true"></i>
                        导入
                    </button>
                </div>
            </div>
            <div class="input-group ml-1 mb-1">
                <div class="input-group-prepend">
                    <div class="input-group-text">Excel文件</div>
                </div>
                <div class="input-group-append">
                    <div class="btn btn-sm btn-secondary">
                        <i class="fa fa-upload" aria-hidden="true"></i> 导入
                        <input @ref="inputXlsxFile" id="inputXlsxFile" type="file" accept=".xlsx" style="width: 0px; height: 0px; visibility: collapse;" @onchange="@onInputXlsxFileChanged">
                        <label title="导入"
                            style="position: absolute;top: 0;left: 0;right:0;margin:0;height:100%;cursor:pointer"
                            for="inputXlsxFile">
                        </label>
                    </div>
                    <a href="/api/device/export/excel" target="_blank" class="btn btn-sm btn-secondary"
                        style="align-content: center;">
                        <i class="fa fa-download" aria-hidden="true"></i>
                        导出
                    </a>
                </div>
            </div>
            <div class="input-group ml-1 mb-1">
                <div class="input-group-prepend">
                    <div class="input-group-text">状态</div>
                </div>
                <EditForm Model="this">
                    <InputSelect class="form-control" @bind-Value="@searchIsOnline">
                        <option value="">全部</option>
                        <option value="True">在线</option>
                        <option value="False">离线</option>
                    </InputSelect>
                </EditForm>
            </div>
            <div class="input-group ml-1 mb-1">
                <div class="input-group-prepend">
                    <div class="input-group-text">关键字</div>
                </div>
                <input type="text" class="form-control" @bind-value="searchKeywords">
                <div class="input-group-append">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="search">
                        <i class="fa fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
@if (Devices != null)
{
    <div class="row">
        @foreach (var t in Devices.Skip(Offset).Take(PageSize))
        {
            <div class="col-xl-4 col-lg-6 col-sm-12 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa fa-cube" aria-hidden="true"></i>
                        <span>@t.Name</span>
                        @if (t.Enable)
                        {
                            @if (t.IsOnline)
                            {
                                <span class="badge badge-success ml-2">在线</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary ml-2">离线</span>
                            }
                        }
                        else
                        {
                            <span class="badge badge-secondary ml-2">禁用</span>
                        }
                    </div>
                    <div class="card-body small p-2">
                        <p class="mb-0">
                            <span class="font-weight-bold">编号: </span>@t.Id
                        </p>
                        <p class="mb-0">
                            <span class="font-weight-bold">驱动: </span>@t.GetDriverName()
                        </p>
                        <p class="mb-0">
                            <span class="font-weight-bold">厂商: </span> @t.Manufacturer
                        </p>
                        <p class="mb-0">
                            <span class="font-weight-bold">型号: </span> @t.Model
                        </p>
                    </div>
                    <div class="card-footer p-1">
                        <div class="btn-group">
                            @if (t.Enable)
                            {
                                <button type="button" title="禁用" class="btn btn-sm btn-secondary" @onclick="() => Disable(t)">
                                    <i class="fa fa-chain-broken" aria-hidden="true"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" title="启用" class="btn btn-sm btn-secondary" @onclick="() => Enable(t)">
                                    <i class="fa fa-chain" aria-hidden="true"></i>
                                </button>
                            }
                            <button type="button" title="编辑" class="btn btn-sm btn-secondary" @onclick="() => Edit(t)">
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                            </button>
                            <button type="button" title="删除" class="btn btn-sm btn-secondary" @onclick="() => Delete(t)">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="btn-group">
                            <button type="button" title="通道" class="btn btn-sm btn-secondary"
                                @onclick="() => DisplayChannels(t)">
                                <i class="fa fa-video-camera" aria-hidden="true"></i>
                                <span class="badge badge-light">@t.ChannelsCount</span>
                            </button>
                            <button type="button" title="日志" class="btn btn-sm btn-secondary" @onclick="() => DisplayLogs(t)">
                                <i class="fa fa-file" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="row mt-2">
        <div class="col-12">
            <Pagination @bind-PageSize="PageSize" @bind-Offset="Offset" RecordCount="@Devices.Length" />
        </div>
    </div>
}

<ModalWindow @ref="modalWindow" DialogSizeExtraLarge="true" DialogCentered="false" />
<ModalLoading @ref="modalLoading" />
<ModalAlert @ref="modalAlert" />
<ToastStack @ref="toastStack"></ToastStack>