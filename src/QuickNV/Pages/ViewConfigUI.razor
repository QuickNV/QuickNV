<EditForm Model="@ViewConfig" OnValidSubmit="Ok">
    <DataAnnotationsValidator />
    <div class="form-group">
        <label>视频自动播放</label>
        <div class="custom-control custom-switch d-inline">
            <InputCheckbox class="custom-control-input" id="switch_EnableAutoPlay" @bind-Value="ViewConfig.EnableAutoPlay" />
            <label class="custom-control-label" for="switch_EnableAutoPlay"></label>
        </div>
        <ValidationMessage For="@(() => ViewConfig.EnableAutoPlay)" />
    </div>
    
    <div class="form-group">
        <label>自动播放View</label>
        @if (selectViews != null)
        {
            <p>

                @foreach (var item in selectViews)
                {
                    <button type="button" class="btn btn-sm m-1 @(item.Checked ? "btn-info" : "btn-light")"
                        @onclick="@(e => checkView(item))">@item.Name</button>
                }
            </p>
        }
    </div>
    <button type="submit" class="btn btn-primary col-sm-5 col-md-4 col-lg-2">确定</button>
</EditForm>