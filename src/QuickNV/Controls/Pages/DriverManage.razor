<div class="row">
    @foreach (var t in Core.DriverManager.Instance.DriverContexts)
    {
        <div class="col-xl-4 col-lg-6 col-sm-12 mt-2">
            <div class="card">
                <div class="card-header">
                    <i class="fa fa-microchip" aria-hidden="true"></i>
                    <span>@t.DriverInfo.Name</span>
                </div>
                <div class="card-body small p-2">
                    <p class="mb-0">
                        <span class="font-weight-bold">编号: </span>@t.DriverInfo.Id
                    </p>
                    <p class="mb-0">
                        <span class="font-weight-bold">版本: </span>@t.DriverInfo.Version
                    </p>
                    <p class="mb-0">
                        <span class="font-weight-bold">通道: </span> @t.Channel.ChannelName
                    </p>
                    <p class="mb-0">
                        <span class="font-weight-bold">连接时间: </span> @t.Channel.LastConnectedTime
                    </p>
                </div>
            </div>
        </div>
    }
</div>