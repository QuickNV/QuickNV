@inherits SettingComponentBaseWithModalAlert<Model.PlayerConfigModel>
<ModalAlert @ref="modalAlert" />
<EditForm Model="@Config">
    <DataAnnotationsValidator />
    <Tabs>
        <TabPane Key="Times">
            <Tab>时间相关</Tab>
            <ChildContent>
                <div class="card" style="border-top: none;border-top-left-radius: 0;border-top-right-radius: 0;">
                    <div class="card-body">
                        <div class="form-group">
                            <label>等待画面变化超时(单位:秒)</label>
                            <InputNumber class="form-control" @bind-Value="Config.WaitFrameChangeSeconds" />
                            <ValidationMessage For="@(() => Config.WaitFrameChangeSeconds)" />
                        </div>
                        <div class="form-group">
                            <label>快速重试次数</label>
                            <InputNumber class="form-control" @bind-Value="Config.FastRetryTimes" />
                            <ValidationMessage For="@(() => Config.FastRetryTimes)" />
                        </div>
                        <div class="form-group">
                            <label>快速重试间隔(单位:毫秒)</label>
                            <InputNumber class="form-control" @bind-Value="Config.FastRetryInterval" />
                            <ValidationMessage For="@(() => Config.FastRetryInterval)" />
                        </div>
                        <div class="form-group">
                            <label>慢速重试间隔(单位:毫秒)</label>
                            <InputNumber class="form-control" @bind-Value="Config.SlowRetryInterval" />
                            <ValidationMessage For="@(() => Config.SlowRetryInterval)" />
                        </div>
                    </div>
                </div>
            </ChildContent>
        </TabPane>
        <TabPane Key="Player">
            <Tab>播放器</Tab>
            <ChildContent>
                <div class="card" style="border-top: none;border-top-left-radius: 0;border-top-right-radius: 0;">
                    <div class="card-body">
                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <InputCheckbox id="UseProxy" class="custom-control-input"
                                    @bind-Value="Config.UseProxy" />
                                <label class="custom-control-label" for="UseProxy">代理媒体流</label>
                            </div>
                            <ValidationMessage For="@(() => Config.UseProxy)" />
                        </div>
                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <InputCheckbox id="Stretch" class="custom-control-input" @bind-Value="Config.Stretch" />
                                <label class="custom-control-label" for="Stretch">视频拉伸</label>
                            </div>
                            <ValidationMessage For="@(() => Config.Stretch)" />
                        </div>
