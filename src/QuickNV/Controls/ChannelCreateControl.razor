<div class="row">
    <div class="col-12">
        <EditForm Model="@createModel" OnValidSubmit="Ok">
            <DataAnnotationsValidator />
            @if (driverContext != null && driverContext.DriverInfo != null && driverContext.DriverInfo.HasChannelConfig)
            {
                <Tabs NavTabsExtraClass="mb-3">
                    <TabPane Key="1">
                        <Tab>基本</Tab>
                        <ChildContent>
                            <div class="form-group">
                                <label>编号</label>
                                @if (Model == null)
                                {
                                    <InputText class="form-control" @bind-Value="createModel.Id" />
                                }
                                else
                                {
                                    <InputText class="form-control" @bind-Value="createModel.Id" readonly />
                                }
                                <ValidationMessage For="@(() => createModel.Id)" />
                            </div>
                            <div class="form-group">
                                <label>名称</label>
                                <InputText class="form-control" @bind-Value="createModel.Name" />
                                <ValidationMessage For="@(() => createModel.Name)" />
                            </div>
                            <div class="form-group">
                                <label>外部编号</label>
                                <InputText class="form-control" @bind-Value="createModel.ExternalId" />
                                <ValidationMessage For="@(() => createModel.ExternalId)" />
                            </div>
                            <div class="form-group">
                                <label>地点</label>
                                <InputSelect class="form-control" @bind-Value="createModel.AddressId">
                                    <option value="">请选择...</option>
                                    @foreach (var address in Core.AddressManager.Instance.GetAddressTree())
                                    {
                                        <option value="@address.Key">@address.Value</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => createModel.AddressId)" />
                            </div>
                            <div class="form-group">
                                <label>经度</label>
                                <InputNumber class="form-control" @bind-Value="createModel.Lng" />
                                <ValidationMessage For="@(() => createModel.Lng)" />
                            </div>
                            <div class="form-group">
                                <label>纬度</label>
                                <InputNumber class="form-control" @bind-Value="createModel.Lat" />
                                <ValidationMessage For="@(() => createModel.Lat)" />
                            </div>
                        </ChildContent>
                    </TabPane>
                    <TabPane Key="2">
                        <Tab>配置</Tab>
                        <ChildContent>
                            @if (driverContext == null)
                            {
                                <div class="alert alert-warning" role="alert">
                                    未找到设备设置的驱动[@Device.DriverId]！
                                </div>
                            }
                            else
                            {
                                @if (fieldForGetArray != null)
                                {
                                    @foreach (var field in fieldForGetArray)
                                    {
                                        <Quick.Blazor.Bootstrap.QuickFields.Control Field="field"></Quick.Blazor.Bootstrap.QuickFields.Control>
                                    }
                                }
                            }
                        </ChildContent>
                    </TabPane>
                    <TabPane Key="3">
                        <Tab>高级配置</Tab>
                        <ChildContent>
                            <div class="form-group">
                                <InputTextArea class="form-control" rows="10" @bind-Value="createModel.DriverConfig" />
                                <ValidationMessage For="@(() => createModel.DriverConfig)" />
                            </div>
                        </ChildContent>
                    </TabPane>
                </Tabs>
            }
            else
            {
                <Tabs NavTabsExtraClass="mb-3">
                    <TabPane Key="1">
                        <Tab>基本</Tab>
                        <ChildContent>
                            <div class="form-group">
                                <label>编号</label>
                                @if (Model == null)
                                {
                                    <InputText class="form-control" @bind-Value="createModel.Id" />
                                }
                                else
                                {
                                    <InputText class="form-control" @bind-Value="createModel.Id" readonly />
                                }
                                <ValidationMessage For="@(() => createModel.Id)" />
                            </div>
                            <div class="form-group">
                                <label>名称</label>
                                <InputText class="form-control" @bind-Value="createModel.Name" />
                                <ValidationMessage For="@(() => createModel.Name)" />
                            </div>
                            <div class="form-group">
                                <label>外部编号</label>
                                <InputText class="form-control" @bind-Value="createModel.ExternalId" />
                                <ValidationMessage For="@(() => createModel.ExternalId)" />
                            </div>
                            <div class="form-group">
                                <label>地点</label>
                                <InputSelect class="form-control" @bind-Value="createModel.AddressId">
                                    <option value="">请选择...</option>
                                    @foreach (var address in Core.AddressManager.Instance.GetAddressTree())
                                    {
                                        <option value="@address.Key">@address.Value</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => createModel.AddressId)" />
                            </div>
                            <div class="form-group">
                                <label>经度</label>
                                <InputNumber class="form-control" @bind-Value="createModel.Lng" />
                                <ValidationMessage For="@(() => createModel.Lng)" />
                            </div>
                            <div class="form-group">
                                <label>纬度</label>
                                <InputNumber class="form-control" @bind-Value="createModel.Lat" />
                                <ValidationMessage For="@(() => createModel.Lat)" />
                            </div>
                        </ChildContent>
                    </TabPane>
                </Tabs>
            }
            <button type="submit" class="btn btn-primary col-sm-5 col-md-4 col-lg-2">确定</button>
        </EditForm>
    </div>
</div>

<ModalLoading @ref="modalLoading"></ModalLoading>
<ModalAlert @ref="modalAlert"></ModalAlert>
<ToastStack @ref="toastStack" AutoClose="true" />