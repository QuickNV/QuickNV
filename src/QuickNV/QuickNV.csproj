<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<UseAppHost>false</UseAppHost>
		<RollForward>Major</RollForward>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ImplicitUsings>true</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DbContextBackup.Excel" Version="8.0.18.2" />
		<PackageReference Include="Quick.Blazor.Bootstrap.QuickFields" Version="4.4.5" />
		<PackageReference Include="Quick.EntityFrameworkCore.Plus.Dm" Version="8.0.18.2" />
		<PackageReference Include="Quick.EntityFrameworkCore.Plus.MySql" Version="8.0.18.2" />
		<PackageReference Include="Quick.EntityFrameworkCore.Plus.SQLite" Version="8.0.18.2" />
		<PackageReference Include="Quick.Excel" Version="1.0.9" />
		<PackageReference Include="Quick.Protocol.AllClients" Version="2.6.6" />
		<PackageReference Include="Quick.Protocol.WebSocket.Server.AspNetCore" Version="2.6.6" />
		<PackageReference Include="Quick.ZLMediaKit" Version="1.1.0" />
		<PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Swashbuckle.AspNetCore" Version="10.0.1" />
		<PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
		<PackageReference Include="YiQiDong.Core" Version="2.6.8" />
		<PackageReference Include="YiRenZheng.Protocol" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\QuickNV.Driver.Protocol\QuickNV.Driver.Protocol.csproj" />
	  <ProjectReference Include="..\QuickNV.North.Protocol\QuickNV.North.Protocol.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="Controls\ChannelImportControl.razor">
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	  </Content>
	</ItemGroup>
</Project>
