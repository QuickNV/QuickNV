<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<UseAppHost>false</UseAppHost>
		<RollForward>Major</RollForward>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ImplicitUsings>true</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DbContextBackup.Excel" Version="2026.6.523" />
		<PackageReference Include="Quick.Blazor.Bootstrap.QuickFields" Version="2026.20.529" />
		<PackageReference Include="Quick.EntityFrameworkCore.Plus.Dm" Version="2026.10.523" />
		<PackageReference Include="Quick.EntityFrameworkCore.Plus.MySql" Version="2026.10.523" />
		<PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Quick.EntityFrameworkCore.Plus.SQLite" Version="2026.10.523" />
		<PackageReference Include="Quick.Excel" Version="2026.1.522" />
		<PackageReference Include="Quick.Protocol.Pipeline" Version="2.6.11" />
		<PackageReference Include="Quick.Protocol.Tcp" Version="2.6.11" />
		<PackageReference Include="Quick.Protocol.WebSocket.Client" Version="2.6.11" />
		<PackageReference Include="Quick.Protocol.WebSocket.Server.AspNetCore" Version="2.6.11" />
		<PackageReference Include="Quick.Protocol.InterfaceService" Version="2.6.11" />
		<PackageReference Include="Quick.ZLMediaKit" Version="1.1.0" />
		<PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Swashbuckle.AspNetCore" Version="10.1.7" />
		<PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
		<PackageReference Include="YiQiDong.Core" Version="2026.16.507" />
		<PackageReference Include="YiRenZheng.Protocol" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\QuickNV.Protocol\QuickNV.Protocol.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="Controls\ChannelImportControl.razor">
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	  </Content>
	</ItemGroup>
</Project>
